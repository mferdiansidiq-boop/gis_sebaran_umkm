<IfModule mod_rewrite.c>
    Options +FollowSymlinks
    RewriteEngine On

    # Sesuaikan dengan subfolder kamu
    RewriteBase /gis_sebaran_umkm/public/

    # Mengarahkan semua request ke index.php jika file/folder tidak ada
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?/$1 [L]
</IfModule>